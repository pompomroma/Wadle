{
  "name": "wadle",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based AI for vibe programming — builds, modifies and converts real software until it actually works.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "start": "pnpm --filter @wadle/server start",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @wadle/server test",
    "lint": "pnpm --recursive lint",
    "doctor": "pnpm --filter @wadle/server doctor",
    "secrets:scan": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0"
}
