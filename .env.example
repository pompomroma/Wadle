# ---------------------------------------------------------------------------
# Wadle configuration. Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# NEVER commit a real key. `pnpm secrets:scan` blocks key-shaped strings.
# ---------------------------------------------------------------------------

# --- Model backend ---------------------------------------------------------
# Default: NVIDIA NIM hosting Nemotron 3 Ultra.
# Get a key at https://build.nvidia.com — it looks like nvapi-XXXXXXXX...
NVIDIA_API_KEY=nvapi-your-key-here

# Override to point at any OpenAI-compatible endpoint instead.
# Local + free, e.g. Ollama:   LLM_BASE_URL=http://localhost:11434/v1
#                              LLM_MODEL=qwen2.5-coder:32b
#                              LLM_API_KEY=ollama
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_API_KEY=            # falls back to NVIDIA_API_KEY when unset

# --- Server ----------------------------------------------------------------
PORT=5174
HOST=127.0.0.1
DATA_DIR=./data

# Port range allocated to live previews of generated web products.
PREVIEW_PORT_MIN=5200
PREVIEW_PORT_MAX=5299

# --- Agent loop ------------------------------------------------------------
# The loop runs until every acceptance criterion passes. These are the
# safety bounds; state is checkpointed so hitting one resumes, not restarts.
AGENT_MAX_ITERATIONS=200
AGENT_WALL_CLOCK_MS=7200000
AGENT_TOKEN_CEILING=20000000

# --- Sandbox ---------------------------------------------------------------
SANDBOX_TIMEOUT_MS=180000
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_PROCESSES=256
# Dependency installs are the only outbound network generated code may make.
SANDBOX_ALLOW_INSTALL_NETWORK=true
